# ==========================================
# IdeaLens Backend Environment Configuration
# ==========================================

PROJECT_NAME=IdeaLens
VERSION=1.0.0
API_V1_STR=/api/v1

# Environment Deployment Mode: development | test | production
# In 'production' mode, SQLite is strictly blocked, requiring a valid PostgreSQL DATABASE_URL.
ENVIRONMENT=development

# Security & JWT Token
# Development mode accepts defaults. Production requires a 256-bit cryptographically secure key (e.g. openssl rand -hex 32):
SECRET_KEY=generate_with_openssl_rand_hex_32_minimum_64_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local Development SQLite (default):
DATABASE_URL=sqlite:///./idealens.db

# Production PostgreSQL Target (Docker, Supabase, RDS, Neon, Cloud SQL) - REQUIRED when ENVIRONMENT=production:
# DATABASE_URL=postgresql+psycopg2://your_pg_user:your_pg_password@your_pg_host:5432/your_pg_dbname
DATABASE_POOL_SIZE=15
DATABASE_MAX_OVERFLOW=25
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# Redis & Celery Background Tasks
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
USE_IN_PROCESS_BACKGROUND_TASKS=true

# AI Provider Configuration (Options: "auto", "openai", "gemini", "heuristic_fallback")
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Scholarly Metadata Contacts (Polite API access - OpenAlex & Crossref operate without keys)
OPENALEX_MAILTO=research@idealens.ai
CROSSREF_MAILTO=research@idealens.ai

# Optional Research & Patent Providers (Require API access credentials)
IEEE_API_KEY=
USPTO_API_KEY=
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET=

# CORS Allowed Origins
# Development: JSON list or comma-separated string of local ports
# Production: REQUIRED non-localhost domains (e.g. https://idealens.ai,https://app.idealens.ai)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
