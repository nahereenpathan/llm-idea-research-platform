# ==========================================
# IdeaLens Backend Environment Configuration
# ==========================================

PROJECT_NAME=IdeaLens
VERSION=1.0.0
API_V1_STR=/api/v1

# Security & JWT Token (Change to a cryptographically strong secret in production)
SECRET_KEY=idealens_super_secure_production_secret_key_change_me_before_deploying_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local SQLite default (friction-free Windows dev):
DATABASE_URL=sqlite:///./idealens.db

# Or PostgreSQL (uncomment when running PostgreSQL via Docker or local service):
# DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/idealens

# Redis & Celery Background Tasks
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
USE_IN_PROCESS_BACKGROUND_TASKS=true

# AI Provider Configuration (Options: "auto", "openai", "gemini", "heuristic_fallback")
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Scholarly Metadata Contacts (Polite API access)
OPENALEX_MAILTO=research@idealens.ai
CROSSREF_MAILTO=research@idealens.ai

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
